# ⚠️ 이 파일은 예시입니다. 실제 키 값은 이 파일에 넣지 말고,
# Streamlit Community Cloud 앱 설정 > Secrets 에 직접 붙여넣으세요.
# (이 예시 파일은 .gitignore에 의해 GitHub에는 올라가지 않습니다.)

gee_service_account = "my-service-account@project-id.iam.gserviceaccount.com"

# 서비스 계정 JSON 키 파일의 "내용 전체"를 한 줄 문자열로 붙여넣으세요.
# (JSON 파일을 열어서 전체를 복사 후 아래처럼 큰따옴표 안에 붙여넣기)
gee_service_account_key = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
  "client_email": "my-service-account@project-id.iam.gserviceaccount.com",
  ...
}
'''
